# ---------- Server ----------
PORT=3000
# Public HTTPS URL where this app is hosted (Telegram requires HTTPS)
WEBAPP_URL=https://your-domain.com
# true = allows opening the app in a normal browser with a fake test user. NEVER true in production.
DEV_MODE=false
DB_PATH=./data/payplus.db

# ---------- Telegram ----------
# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=Pay_Plus_Bot
# Short name of the Mini App you create in BotFather (/newapp) -> t.me/<bot>/<short name>
APP_SHORT_NAME=app
# Username (without @) users are sent to when tapping "Customer Support"
SUPPORT_USERNAME=PayPlusSupport
# true = the server long-polls Telegram for /start messages (easy). false = use webhook at /api/bot/webhook
BOT_POLLING=true

# ---------- Admin ----------
# Long random string. Used to log into /admin
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- Monetag ----------
# Your Monetag Telegram Mini App zone ID (numbers only)
MONETAG_ZONE_ID=11484941
# Secret you put in the postback URL configured in Monetag (see README)
MONETAG_POSTBACK_SECRET=
# true = only pay a user once Monetag's postback confirms the view (most secure)
MONETAG_REQUIRE_POSTBACK=false

# ---------- Rewards (USD) ----------
AD_REWARD=0.30
AD_DAILY_LIMIT=15
AD_COOLDOWN_SECONDS=30
# Minimum seconds between "ad started" and "ad completed" (anti-cheat)
AD_MIN_SECONDS=10
REFERRAL_REWARD=0.75
# Invited friend must watch this many ads before the inviter is paid (anti-fake-accounts)
REFERRAL_REQUIRED_ADS=3
MIN_WITHDRAWAL=10
# For tasks that can't be verified automatically (bots, YouTube): seconds after "Start" before claim is allowed
TASK_MIN_SECONDS=15
